<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>GameLauncher</RootNamespace>
    <AssemblyName>GameLauncher</AssemblyName>
    <!-- Public release label: MMddyy.HHmm (set per build by scripts/Build-Installer.ps1). Numeric metadata: yyyy.MMdd.HHmm.0. -->
    <Version>2026.1029.1139</Version>
    <InformationalVersion>102926.1139</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>2026.1029.1139.0</AssemblyVersion>
    <FileVersion>2026.1029.1139.0</FileVersion>
    <Product>Launchpad</Product>
    <Description>A local game, emulator, and tool launcher for Windows.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>GameLauncher.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GameLauncher.Contracts/GameLauncher.Contracts.csproj" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <!-- Static files are embedded and served from /assets/*, not the default static web root. -->
    <Content Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/site.css" LogicalName="GameLauncher.site.css" />
    <EmbeddedResource Include="wwwroot/site.js" LogicalName="GameLauncher.site.js" />
    <EmbeddedResource Include="GameLauncher.ico" LogicalName="GameLauncher.icon.ico" />
  </ItemGroup>
  <!-- WebView2 adds both UI adapters; this WinForms host does not use WPF.
       Remove the unused adapter after package imports, before assembly resolution. -->
  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
