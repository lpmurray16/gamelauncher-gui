@page
@model IndexModel
@using GameLauncher.Domain
@using GameLauncher.Services
@{
    ViewData["Title"] = Model.Category.ToString();
    ViewData["Section"] = Model.Category.ToString();
    ViewData["LibraryDashboard"] = true;
    var featured = Model.Featured;
    var featuredHero = featured?.HeroImageFile ?? featured?.CoverImageFile;
    var activeSet = Model.CurrentCollection;
}
<header class="page-heading" data-category-dashboard>
    <div>
        <h1>@ViewData["Title"]<span class="heading-dot">.</span></h1>
    </div>
    <div class="actions">
        <a class="button secondary" asp-page="/Scan" asp-route-category="@Model.Category">Scan a folder</a>
        <a class="button primary" asp-page="/Edit" asp-route-category="@Model.Category"><span aria-hidden="true">＋</span> Add entry</a>
    </div>
</header>
<div asp-validation-summary="All" class="validation" role="alert"></div>

@if (featured is not null)
{
    <section class="hero-banner" aria-label="Featured entry">
        @if (featuredHero is not null) { <img class="hero-image" src="/artwork/image/@featuredHero" alt="" /> }
        <div class="hero-content">
            <div class="hero-copy">
                <p class="eyebrow">@(featured.LastLaunchedUtc.HasValue ? "JUMP BACK IN" : Model.FeaturedIsFavorite ? "FROM YOUR FAVORITES" : "FEATURED")</p>
                <h2 title="@featured.Title">@featured.Title</h2>
                <p class="hero-meta">@(featured.LastLaunchedUtc.HasValue ? $"Last launched {featured.LastLaunchedUtc.Value.ToLocalTime():MMM d · h:mm tt}" : "Ready for your first launch")</p>
            </div>
            <form method="post" asp-page-handler="Launch" asp-route-category="@Model.Category" asp-route-collectionId="@Model.CollectionId" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-favorites="@Model.Favorites" data-busy-form data-busy-label="Launching…">
                <input type="hidden" name="id" value="@featured.Id" />
                <button class="button launch hero-launch" type="submit"><span aria-hidden="true">▶</span> Play</button>
            </form>
        </div>

    </section>
}

<section class="library-toolbar" aria-label="Filter library">
    <div class="tabs">
        <a class="tab @(!Model.Favorites && activeSet is null ? "selected" : "")" asp-page="/Index" asp-route-category="@Model.Category" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort">All entries <span>@Model.MatchingCount</span></a>
        <a class="tab @(Model.Favorites && activeSet is null ? "selected" : "")" asp-page="/Index" asp-route-category="@Model.Category" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-favorites="true">Favorites <span>@Model.FavoriteCount</span></a>
        @* Collections are named filter sets, shown only on the Games dashboard. *@
        @foreach (var coll in Model.Collections)
        {
            <a class="tab @(activeSet?.Id == coll.Id ? "selected" : "")" asp-page="/Index" asp-route-category="@Model.Category" asp-route-collectionId="@coll.Id" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort">@coll.Name <span>@Model.CollectionCounts.GetValueOrDefault(coll.Id)</span></a>
        }
        @if (Model.ShowsCollections)
        {
            <a class="tab tab-add" asp-page="/Collections" aria-label="Manage game sets" title="Manage game sets">＋</a>
        }
    </div>
</section>

<div class="library-subtoolbar">
<nav class="library-sort" aria-label="Sort library">
    <span class="sort-caption">Sort by</span>
    @foreach (var option in new[] { (Value: "favorites", Label: "Favorites first"), (Value: "az", Label: "A–Z"), (Value: "za", Label: "Z–A"), (Value: "recent", Label: "Last played") })
    {
        var href = $"/Index?category={Model.Category}&search={Uri.EscapeDataString(Model.Search ?? "")}&favorites={Model.Favorites.ToString().ToLowerInvariant()}&sort={option.Value}"
            + (activeSet is null ? "" : $"&collectionId={activeSet.Id}");
        <a class="sort-chip @(Model.Sort == option.Value ? "selected" : "")"
           href="@href"
           aria-current="@(Model.Sort == option.Value ? "true" : null)">@option.Label</a>
    }
</nav>
@if (Model.Entries.Count > 0 && Model.ShowsCollections && Model.Collections.Count > 0)
{
    <button type="button" class="button secondary" form="bulk-collection" data-bulk-toggle aria-expanded="false" aria-controls="bulk-controls" hidden>Select entries</button>
}
<p class="library-count">@Model.Entries.Count @(Model.Entries.Count == 1 ? "entry" : "entries") in view</p>
</div>

@if (Model.Entries.Count == 0)
{
    <section class="empty-state" data-library-touch><div class="empty-symbol" aria-hidden="true">▦</div><p class="eyebrow">MAKE IT YOURS</p><h2>@(!string.IsNullOrWhiteSpace(Model.Search) ? "No matching entries" : activeSet is not null ? $"Nothing in {activeSet.Name} yet" : Model.Favorites ? "Your favorites start here" : "A clean slate. A great setup.")</h2><p>@(!string.IsNullOrWhiteSpace(Model.Search) ? "Try another search or return to the full category." : activeSet is not null ? "Open a game's options menu and choose Add to… to put it in this set." : Model.Favorites ? "Select the star on an entry to keep it close at hand." : "Add an executable or scan a folder to bring your local library together.")</p><div class="actions"><a class="button secondary" asp-page="/Index" asp-route-category="@Model.Category">View all entries</a><a class="button primary" asp-page="/Scan" asp-route-category="@Model.Category">Scan a folder <span aria-hidden="true">↗</span></a></div></section>
}
else
{
    if (Model.ShowsCollections && Model.Collections.Count > 0)
    {
        <form id="bulk-collection" method="post" asp-page-handler="BulkAdd" asp-route-category="@Model.Category" asp-route-collectionId="@Model.CollectionId" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-favorites="@Model.Favorites" class="bulk-toolbar" data-bulk-form>
            <div id="bulk-controls" class="bulk-controls" data-bulk-controls>
            <span data-bulk-count role="status" aria-live="polite">0 selected</span>
            <button type="button" class="button secondary" data-bulk-all>Select all shown games</button>
            <button type="button" class="button secondary" data-bulk-clear>Clear selection</button>
            <label for="bulk-target">Add to collection</label>
            <select id="bulk-target" name="targetCollectionId" required>
                @foreach (var collection in Model.Collections) { <option value="@collection.Id">@collection.Name</option> }
            </select>
            <button type="submit" class="button primary" data-bulk-submit>Add selected</button>
            <small>Existing members are skipped. Select up to 500 games; selection resets when you change pages or filters.</small>
            </div>
        </form>
    }
    <section class="entry-grid" data-library-touch aria-label="Library entries">
    @foreach (var entry in Model.Entries)
    {
        <article class="entry-card">
            <div class="cover">
                @if (entry.CoverImageFile is not null)
                {
                    <img src="/artwork/image/@entry.CoverImageFile" alt="Cover for @entry.Title" loading="lazy" />
                }
                else
                {
                    <div class="cover-fallback" aria-hidden="true"><span>@(string.IsNullOrWhiteSpace(entry.Title) ? "↗" : entry.Title.Trim().Substring(0, 1).ToUpperInvariant())</span></div>
                }

                <!-- Favorite button (top-left, always visible) -->
                <form method="post" asp-page-handler="Favorite" asp-route-category="@Model.Category" asp-route-collectionId="@Model.CollectionId" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-favorites="@Model.Favorites" class="cover-favorite"><input type="hidden" name="id" value="@entry.Id" /><button class="favorite @(entry.IsFavorite ? "is-favorite" : "")" type="submit" aria-pressed="@entry.IsFavorite.ToString().ToLowerInvariant()" aria-label="@(entry.IsFavorite ? "Remove " + entry.Title + " from favorites" : "Favorite " + entry.Title)">@(entry.IsFavorite ? "★" : "☆")</button></form>

                <!-- Hover action overlay -->
                <div class="cover-overlay">
                    <!-- Options menu (top-right) -->
                    <div class="overlay-action overlay-menu">
                        <button class="btn-icon menu-trigger" aria-label="Options for @entry.Title" aria-expanded="false" aria-haspopup="true">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                        </button>
                        <div class="menu-dropdown" role="menu">
                            <a class="menu-item" asp-page="/Edit" asp-route-id="@entry.Id" role="menuitem" aria-label="Edit @entry.Title">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Edit
                            </a>
                            <form method="post" asp-page-handler="OpenContainingFolder" asp-antiforgery="true" asp-route-category="@Model.Category" asp-route-collectionId="@Model.CollectionId" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-favorites="@Model.Favorites">
                                <input type="hidden" name="id" value="@entry.Id" />
                                <button type="submit" class="menu-item" role="menuitem" aria-label="Open containing folder for @entry.Title">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/><path d="M3 9h18"/></svg>
                                    Folder
                                </button>
                            </form>
                            @if (Model.ShowsCollections)
                            {
                                <div class="menu-divider" role="separator"></div>
                                <div class="menu-submenu">
                                    <button type="button" class="menu-item submenu-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false" aria-controls="add-to-@entry.Id">
                                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12H5"/></svg>
                                        Add to…
                                        <span class="submenu-caret" aria-hidden="true">›</span>
                                    </button>
                                    <div class="submenu-dropdown" id="add-to-@entry.Id" role="menu" aria-label="Add @entry.Title to a collection" hidden>
                                        @foreach (var coll in Model.Collections)
                                        {
                                            var inCollection = Model.Memberships.Contains((coll.Id, entry.Id));
                                            <form method="post" asp-page-handler="AddToCollection" asp-route-category="@Model.Category" asp-route-collectionId="@Model.CollectionId" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-favorites="@Model.Favorites" class="submenu-form">
                                                <input type="hidden" name="id" value="@entry.Id" />
                                                <input type="hidden" name="targetCollectionId" value="@coll.Id" />
                                                <button type="submit" class="submenu-item @(inCollection ? "checked" : "")" role="menuitemcheckbox" aria-checked="@inCollection.ToString().ToLowerInvariant()" aria-label="@(inCollection ? "Remove from " : "Add to ")@coll.Name">
                                                    <span class="submenu-check" aria-hidden="true">@(inCollection ? "✓" : "")</span>@coll.Name
                                                </button>
                                            </form>
                                        }
                                        @if (Model.Collections.Count > 0) { <div class="submenu-divider" role="separator"></div> }
                                        <a class="submenu-item" asp-page="/Collections" asp-route-category="@Model.Category" role="menuitem">
                                            <span class="submenu-check" aria-hidden="true">＋</span>New collection…
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Play button (centered) -->
                    <form method="post" asp-page-handler="Launch" asp-route-category="@Model.Category" asp-route-collectionId="@Model.CollectionId" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-favorites="@Model.Favorites" data-busy-form data-busy-label="Launching…" class="overlay-action overlay-play" aria-label="Play @entry.Title">
                        <input type="hidden" name="id" value="@entry.Id" />
                        <button class="btn-icon" type="submit" aria-label="Play @entry.Title">
                            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        </button>
                    </form>
                </div>
            </div>
            <div class="card-body">
                @if (entry.Category == LibraryCategory.Games && Model.Collections.Count > 0)
                {
                    <label class="bulk-entry-select"><input type="checkbox" name="SelectedEntryIds" value="@entry.Id" form="bulk-collection" data-bulk-entry checked="@Model.SelectedEntryIds.Contains(entry.Id)" aria-label="Select @entry.Title for collection actions" /> Select</label>
                }
                <h2 title="@entry.Title">@entry.Title</h2>

            </div>
        </article>
    }
    </section>
}
