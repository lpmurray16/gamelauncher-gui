@inject GameLauncher.Services.BrowserLauncher Browser
@{
    var active = ViewData["Section"] as string ?? "Games";
    var hasBrowser = false;
    string? browserError = null;
    try { hasBrowser = !string.IsNullOrWhiteSpace(Browser.ExecutablePath); }
    catch (Exception error) when (error is InvalidOperationException or System.IO.IOException or UnauthorizedAccessException)
    { browserError = error.Message; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Launchpad</title>
    <link rel="icon" href="/icon.ico" />
    <link rel="stylesheet" href="/assets/site.css" />
    <script src="/assets/site.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" asp-page="/Index"><img class="brand-icon" src="/icon.ico" alt="" width="38" height="38" /><span>Launchpad<small>YOUR LOCAL LIBRARY</small></span></a>
        <p class="nav-caption">WORKSPACE</p>
        <nav aria-label="Main navigation">
            @foreach (var category in new[] { LibraryCategory.Games, LibraryCategory.Emulators, LibraryCategory.Tools })
            {
                <a class="nav-link @(active == category.ToString() ? "active" : "")" data-category-nav
                   asp-page="/Index"
                   asp-route-category="@category"
                   aria-current="@(active == category.ToString() ? "page" : null)">
                    <span class="nav-icon" aria-hidden="true">@(category == LibraryCategory.Games ? "▦" : category == LibraryCategory.Emulators ? "◈" : "⌘")</span>
                    @category
                </a>
            }
            <a class="nav-link @(active == "Collections" ? "active" : "")" asp-page="/Collections" aria-current="@(active == "Collections" ? "page" : null)"><span class="nav-icon" aria-hidden="true">⚿</span>Collections</a>
            <a class="nav-link @(active == "Settings" ? "active" : "")" asp-page="/Settings" aria-current="@(active == "Settings" ? "page" : null)"><span class="nav-icon" aria-hidden="true">⚙</span>Settings</a>
        </nav>
        <div class="sidebar-footer"><span class="status-dot"></span> Local by design<small>Your library. Your machine.</small></div>
    </aside>
    <main id="main" class="main" tabindex="-1">
        <div class="topline">
            @if (browserError is not null)
            {
                <a class="browser-button" asp-page="/Settings" asp-fragment="browser" title="@browserError">Setup browser</a>
            }
            else
            {
                <form method="post" asp-page="/Settings" asp-page-handler="@(hasBrowser ? "LaunchBrowser" : "ChooseBrowser")" class="browser-shortcut" data-busy-form data-busy-label="@(hasBrowser ? "Opening…" : "Choosing…")">
                    <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase.ToString() + Context.Request.Path.ToString() + Context.Request.QueryString.ToString())" />
                    <button type="submit" class="browser-button" aria-label="@(hasBrowser ? "Launch browser" : "Setup browser")" title="@(hasBrowser ? "Launch browser · Change in Settings" : "Choose your browser executable")">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" /></svg>
                        <span>@(hasBrowser ? "Browser" : "Setup browser")</span>
                    </button>
                </form>
            }
            <form method="get" asp-page="/GlobalSearch" class="global-search" role="search" aria-label="Search all libraries">
                <label class="sr-only" for="global-search">Search Games, Tools and Emulators</label>
                <input id="global-search" type="search" name="q" value="@(ViewData["GlobalQuery"] as string)" placeholder="Search all libraries…" maxlength="200" />
                <button type="submit" aria-label="Search all libraries">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.9-3.9" /></svg>
                </button>
            </form>
            <div class="window-controls" aria-label="Window controls">
                <button type="button" data-window-fullscreen aria-label="Enter fullscreen (F11)" title="Enter fullscreen (F11)" aria-pressed="false">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg>
                </button>
                <button type="button" data-window-close aria-label="Close Launchpad" title="Close Launchpad">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>
        </div>
        @if (TempData["Notice"] is string notice)
        {
            <div class="notice toast" role="status" data-toast>@notice</div>
        }
        <section class="notice" data-power-banner hidden>
            <p data-power-banner-text role="status"></p>
            <div class="actions">
                <form method="post" asp-page="/Power" asp-page-handler="Cancel"><button type="submit" class="button secondary">Cancel shutdown</button></form>
                <a class="button secondary" asp-page="/Power">PC power</a>
            </div>
        </section>
        @RenderBody()
        <p class="navigation-hint">Navigate: arrows / D-pad · Select: Enter / A · Options: Shift+F10 / X · Back: Esc / B · Sidebar: F1 / View · Jump ⅓ back / forward: LB / RB · Category: L2 / R2 (LT / RT) · Favorite: Y (controller) · Windows keyboard: A on a text field / F2 · Fullscreen: F11</p>
        <footer class="page-footer">Less searching. More playing.<span>GAME LAUNCHER / LOCAL LIBRARY</span></footer>
    </main>
</div>
</body>
</html>
