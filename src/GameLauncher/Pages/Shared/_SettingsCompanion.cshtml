@model SettingsModel
<section class="panel">
    <h2>LAN access</h2>
    <p class="settings-status">Trusted networks only. Companion traffic is unencrypted.</p>
    <form method="post" asp-page="/Settings" asp-route-tab="companion" asp-page-handler="CompanionSave" data-confirm="Save companion access preferences? Enable access only on a trusted private network. Companion traffic uses unencrypted HTTP; people able to inspect it could capture credentials and control your saved games.">
        <label class="check-label"><input asp-for="Enabled" /> Enable Android companion access</label>
        <div class="field"><label asp-for="Port">LAN port</label><input asp-for="Port" type="number" min="1024" max="65535" required /></div>
        <button type="submit" class="button primary">Save access</button>
    </form>
    <p class="settings-status">Restart after enabling access or changing the port. Disabling takes effect immediately.</p>
    @if (Model.Access.ListenerError is string listenerError)
    {
        <p class="validation" role="alert">@listenerError</p>
    }
    <dl class="settings-list">
        <div><dt>Computer</dt><dd>@Model.Access.Device.Name</dd></div>
        <div><dt>Server</dt><dd>@(Model.Access.IsActive ? $"Online · port {Model.Access.ListeningPort}" : "Offline — restart if just enabled")</dd></div>
        <div><dt>IPv4 addresses</dt><dd>@(Model.Addresses.Count == 0 ? "No supported LAN IPv4 address found." : string.Join(" · ", Model.Addresses.Select(address => address.Label)))</dd></div>
    </dl>
</section>
<section class="panel">
    <h2>Pair a phone</h2>
    <p class="settings-status">In Launchpad Companion, choose <strong>Add PC → Scan QR</strong>.</p>
    <form method="post" asp-page="/Settings" asp-route-tab="companion" asp-page-handler="CompanionPair"><button type="submit" class="button primary" disabled="@(!Model.Access.IsActive)">Generate pairing code</button></form>
    @if (Model.PairingCode is string code)
    {
        <div class="companion-pairing" data-companion-pairing data-expires="@(Model.PairingExpires?.ToUnixTimeMilliseconds())">
            <div data-pairing-live hidden>
                @if (Model.PairingQrs.Count > 0)
                {
                    <div class="field">
                        <label for="pairing-network">Network address</label>
                        <select id="pairing-network" data-pairing-network aria-describedby="pairing-network-help">
                            @foreach (var qr in Model.PairingQrs)
                            {
                                <option value="@qr.Host">@qr.Label</option>
                            }
                        </select>
                    </div>
                    <p id="pairing-network-help" class="helper">Choose the network shared with your phone, not a VPN.</p>
                    @foreach (var qr in Model.PairingQrs)
                    {
                        <div data-pairing-host="@qr.Host" hidden>
                            <img class="companion-qr" src="@qr.Image" alt="Pairing QR code for @Model.Access.Device.Name at @qr.Host" />
                            <p class="helper">@qr.Label · active port @Model.Access.ListeningPort</p>
                        </div>
                    }
                }
                else
                {
                    <p class="validation">No LAN IPv4 address found. Check your connection.</p>
                }
                <div class="provider-status has-key"><div class="provider-status-copy"><div><span class="provider-status-name">ONE-TIME PAIRING CODE</span><strong class="companion-code">@code</strong><p>Expires at @Model.PairingExpires?.ToLocalTime().ToString("HH:mm:ss"). Single use.</p></div></div></div>
                <p class="helper">Keep this code private. It expires after two minutes.</p>
            </div>
            <p data-pairing-status role="status">Checking pairing-code expiry…</p>
            <noscript><p>Enable JavaScript in the launcher to display the time-limited QR and pairing code.</p></noscript>
        </div>
    }
    <form method="post" asp-page="/Settings" asp-route-tab="companion" asp-page-handler="CompanionRevoke" data-confirm="Revoke every phone paired with this computer? They will need to pair again."><button type="submit" class="button danger">Revoke all phone pairings</button></form>
</section>
<section class="panel" aria-label="Connection help">
    <details class="settings-help"><summary>Connection help</summary><div class="settings-help-copy"><p>Use the same private network as your phone. If blocked, run <code>scripts/Set-CompanionFirewall.ps1</code> from an administrator PowerShell window.</p><p>Never enable public-network access or router port forwarding.</p></div></details>
</section>