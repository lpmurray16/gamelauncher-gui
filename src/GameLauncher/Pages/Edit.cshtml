@page
@model EditModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit entry" : "Add entry";
    ViewData["Section"] = Model.Category.ToString();
}
<a class="back-link" asp-page="/Index" asp-route-category="@Model.Category">← Back to @Model.Category</a>
<header class="page-heading"><div><h1>@ViewData["Title"]<span class="heading-dot">.</span></h1></div></header>
<div asp-validation-summary="All" class="validation" role="alert"></div>
<form method="post" asp-page="/Edit" asp-page-handler="" class="panel editor" data-busy-form data-busy-label="Saving…">
    <input asp-for="Id" type="hidden" />
    <div class="panel-heading"><span class="step-number">01</span><div><h2>Entry details</h2><p>The essentials for a one-click launch.</p></div></div>
    <div class="form-grid"><div class="field"><label asp-for="Title">Display name <span class="required">*</span></label><input asp-for="Title" placeholder="Name your entry" maxlength="200" required /><span asp-validation-for="Title"></span></div><div class="field"><label asp-for="Category"></label><select asp-for="Category" asp-items="Html.GetEnumSelectList<LibraryCategory>()"></select></div></div>
    <div class="field"><label asp-for="TargetPath">Launch file path <span class="required">*</span></label><div class="input-action"><input asp-for="TargetPath" placeholder="C:\Games\MyGame\game.exe" required spellcheck="false" /><button type="button" class="button secondary browse-path" data-browse-kind="launch" aria-label="Browse for launch file"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v2M3 7h6l2 3h11l-3 10H3L1 10h3" /></svg></button></div><span asp-validation-for="TargetPath"></span><small>Use the full path to a trusted .exe, .lnk, or Steam game .url shortcut. Windows shortcuts can run programs with their own arguments; only add shortcuts you trust.</small></div>
    <div class="form-grid"><div class="field"><label asp-for="Arguments">Launch arguments <span class="optional">optional</span></label><input asp-for="Arguments" spellcheck="false" placeholder="Additional command-line options" /><small>Custom arguments apply to .exe files. Shortcuts keep their own arguments.</small></div><div class="field"><label asp-for="WorkingDirectory">Working directory <span class="optional">optional</span></label><div class="input-action"><input asp-for="WorkingDirectory" spellcheck="false" placeholder="Default: executable folder" /><button type="button" class="button secondary browse-path" data-browse-kind="working" aria-label="Browse for working directory"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v2M3 7h6l2 3h11l-3 10H3L1 10h3" /></svg></button></div></div></div>
    <div class="field"><label asp-for="TrackingExecutablePath">Status tracking executable <span class="optional">optional</span></label><div class="input-action"><input asp-for="TrackingExecutablePath" spellcheck="false" maxlength="32767" placeholder="C:\Games\MyGame\game.exe" /><button type="button" class="button secondary browse-path" data-browse-kind="tracking" aria-label="Browse for status tracking executable"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v2M3 7h6l2 3h11l-3 10H3L1 10h3" /></svg></button></div><span asp-validation-for="TrackingExecutablePath"></span><small>Used to detect whether this entry is running and to identify the game for companion Stop/Force stop; this path is never executed. Leave blank to track the launch file when it is an .exe. For .lnk or .url shortcuts, or launchers that start a different game executable, enter the full local path to the actual game's .exe, not Steam or another launcher. Status checks run every two seconds; protected or elevated processes may not be detectable or stoppable.</small></div>
    <label class="check-label"><input asp-for="IsFavorite" /> Keep this entry in favorites</label>
    <details class="launch-group">
        <summary>Bundled launch group</summary>
        <p>Launch alongside this entry. For example, select BetterJoy here when editing Eden. Add companion programs to your library first; they can be in any category.</p>
        @if (Model.CompanionChoices.Count == 0)
        {
            <p class="notice">No other entries are available yet. Save this entry, add your companion program, then return here to link them.</p>
        }
        else
        {
            <fieldset class="launch-companion-options">
                <legend>Launch alongside <span class="optional">up to @GameLauncher.Services.LibraryService.MaxCompanions entries</span></legend>
                @foreach (var companion in Model.CompanionChoices)
                {
                    <label class="launch-companion-option"><input type="checkbox" name="CompanionIds" value="@companion.Id" checked="@Model.CompanionIds.Contains(companion.Id)" /><span><strong>@companion.Title <small>@companion.Category</small></strong><small>@companion.TargetPath</small></span></label>
                }
            </fieldset>
        }
        <p class="launch-group-note">Selected companions start first in A–Z order using their own saved settings, followed immediately by this entry. This does not wait for companions to finish initializing. Their own bundles are not followed, and nothing closes automatically.</p>
        <p class="launch-group-note">Companion .exe files are skipped when the same executable is already running. Detection is best effort: shortcuts and processes Windows cannot inspect may launch again. Uncheck companions to unlink them; removing an entry also removes its bundle links, never its files.</p>
    </details>
    <div class="form-footer"><a class="button secondary" asp-page="/Index" asp-route-category="@Model.Category">Back to library</a><button type="submit" class="button primary">@(Model.Id.HasValue ? "Save changes" : "Add to library") <span aria-hidden="true">↗</span></button></div>
</form>
@if (Model.Id.HasValue)
{
    <partial name="_EntryArtwork" model="Model" />
    <section class="panel danger-panel"><h2>Remove from library</h2><p>This only removes the entry from Launchpad. It does not delete or uninstall any files.</p><form method="post" asp-page-handler="Delete"><input asp-for="Id" type="hidden" id="delete-id" /><label class="check-label"><input asp-for="ConfirmRemoval" required /> I want to remove this library entry.</label><button class="button danger" type="submit">Remove entry</button></form></section>
}
