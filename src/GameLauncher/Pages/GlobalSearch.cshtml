@page
@model GlobalSearchModel
@using GameLauncher.Domain
@using GameLauncher.Services
@{
    ViewData["Title"] = "Global Search";
    ViewData["Section"] = "GlobalSearch";
    ViewData["GlobalQuery"] = Model.Q;
}
<a class="back-link" asp-page="/Index">← Back to library</a>
<header class="page-heading">
    <div><p class="eyebrow">ACROSS YOUR LIBRARIES</p><h1>Global search<span class="heading-dot">.</span></h1>
    <p class="lede">Search Games, Tools and Emulators together.</p></div>
</header>
<div asp-validation-summary="All" class="validation" role="alert"></div>
@if (!Model.HasQuery)
{
    <section class="empty-state"><h2>Find anything in your library</h2><p>Enter a title in the search box at the top right to search all three libraries.</p></section>
}
else if (!ViewData.ModelState.IsValid)
{
    <p class="lede">The search could not be completed. Review the message above and try again.</p>
}
else if (Model.Entries.Count == 0)
{
    <section class="empty-state"><h2>No matches for “@Model.Q”</h2><p>Try a shorter title or a different spelling. All three libraries were searched.</p></section>
}
else
{
    <div class="search-result-header"><span class="search-query">@Model.Entries.Count results for “<strong>@Model.Q</strong>”</span><span class="search-query">A–Z · All libraries</span></div>
    <div class="library-sort" aria-label="Results by library">
        @foreach (var category in new[] { LibraryCategory.Games, LibraryCategory.Tools, LibraryCategory.Emulators })
        {
            <span class="sort-chip">@category · @Model.Entries.Count(entry => entry.Category == category)</span>
        }
    </div>
    <section class="entry-grid" aria-label="Library entries">
    @foreach (var entry in Model.Entries)
    {
        <article class="entry-card">
            <div class="cover">
                @if (entry.CoverImageFile is not null)
                {
                    <img src="/artwork/image/@entry.CoverImageFile" alt="Cover for @entry.Title" loading="lazy" />
                }
                else
                {
                    <div class="cover-fallback" aria-hidden="true"><span>@(string.IsNullOrWhiteSpace(entry.Title) ? "↗" : entry.Title.Trim().Substring(0, 1).ToUpperInvariant())</span></div>
                }

                <!-- Favorite button (top-left, always visible) -->
                <form method="post" asp-page-handler="Favorite" asp-route-q="@Model.Q" class="cover-favorite"><input type="hidden" name="id" value="@entry.Id" /><button class="favorite @(entry.IsFavorite ? "is-favorite" : "")" type="submit" aria-pressed="@entry.IsFavorite.ToString().ToLowerInvariant()" aria-label="@(entry.IsFavorite ? "Remove " + entry.Title + " from favorites" : "Favorite " + entry.Title)">@(entry.IsFavorite ? "★" : "☆")</button></form>

                <!-- Hover action overlay -->
                <div class="cover-overlay">
                    <!-- Options menu (top-right) -->
                    <div class="overlay-action overlay-menu">
                        <button class="btn-icon menu-trigger" aria-label="Options for @entry.Title" aria-expanded="false" aria-haspopup="true">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                        </button>
                        <div class="menu-dropdown" role="menu">
                            <a class="menu-item" asp-page="/Edit" asp-route-id="@entry.Id" role="menuitem" aria-label="Edit @entry.Title">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Edit
                            </a>
                            <a class="menu-item" asp-page="/Artwork" asp-route-id="@entry.Id" role="menuitem" aria-label="Artwork for @entry.Title">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                Art
                            </a>
                            @if (entry.Category == LibraryCategory.Games)
                            {
                                <div class="menu-divider" role="separator"></div>
                                <div class="menu-submenu">
                                    <button type="button" class="menu-item submenu-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false" aria-controls="add-to-@entry.Id">
                                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12H5"/></svg>
                                        Add to…
                                        <span class="submenu-caret" aria-hidden="true">›</span>
                                    </button>
                                    <div class="submenu-dropdown" id="add-to-@entry.Id" role="menu" aria-label="Add @entry.Title to a collection" hidden>
                                        @foreach (var coll in Model.Collections)
                                        {
                                            var inCollection = Model.Memberships.Contains((coll.Id, entry.Id));
                                            <form method="post" asp-page-handler="AddToCollection" asp-route-q="@Model.Q" class="submenu-form">
                                                <input type="hidden" name="id" value="@entry.Id" />
                                                <input type="hidden" name="targetCollectionId" value="@coll.Id" />
                                                <button type="submit" class="submenu-item @(inCollection ? "checked" : "")" role="menuitemcheckbox" aria-checked="@inCollection.ToString().ToLowerInvariant()" aria-label="@(inCollection ? "Remove from " : "Add to ")@coll.Name">
                                                    <span class="submenu-check" aria-hidden="true">@(inCollection ? "✓" : "")</span>@coll.Name
                                                </button>
                                            </form>
                                        }
                                        @if (Model.Collections.Count > 0) { <div class="submenu-divider" role="separator"></div> }
                                        <a class="submenu-item" asp-page="/Collections" role="menuitem">
                                            <span class="submenu-check" aria-hidden="true">＋</span>New collection…
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Play button (centered) -->
                    <form method="post" asp-page-handler="Launch" asp-route-q="@Model.Q" data-busy-form data-busy-label="Launching…" class="overlay-action overlay-play" aria-label="Launch @entry.Title">
                        <input type="hidden" name="id" value="@entry.Id" />
                        <button class="btn-icon" type="submit" aria-label="Launch @entry.Title">
                            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        </button>
                    </form>
                </div>
            </div>
            <div class="card-body">
                <a class="result-category" asp-page="/Index" asp-route-category="@entry.Category">@entry.Category</a>
                <h2 title="@entry.Title">@entry.Title</h2>
                <p class="last-played">@(entry.LastLaunchedUtc.HasValue ? "Last launched " + entry.LastLaunchedUtc.Value.ToLocalTime().ToString("MMM d · HH:mm") : "Not launched yet")</p>
            </div>
        </article>
    }
    </section>
}
